# MongoDB Atlas connection string (Database > Connect > Drivers)
# e.g. mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
FURNITURE_DB_URI=

# Name of the database that holds the "furniture" and "favorites" collections
FURNITURE_NS=furniture_db

# Port the server listens on locally (hosts like Render/Railway inject their own)
PORT=8000
